{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "bank_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "exam_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "en",
          "es"
        ]
      }
    },
    "default_language": {
      "enum": [
        "en",
        "es"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "name": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "es": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "quiz": {
          "type": "object",
          "properties": {
            "question_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "unscored_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 499
            },
            "time_mode": {
              "enum": [
                "fixed",
                "proportional"
              ]
            },
            "target_percentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "question_count",
            "duration_seconds",
            "unscored_count",
            "time_mode",
            "target_percentage"
          ],
          "additionalProperties": false
        },
        "exam": {
          "type": "object",
          "properties": {
            "question_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "unscored_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 499
            },
            "time_mode": {
              "const": "fixed"
            },
            "target_percentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "question_count",
            "duration_seconds",
            "unscored_count",
            "time_mode",
            "target_percentage"
          ],
          "additionalProperties": false
        },
        "domain_weights": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 30,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "rush": {
          "type": "object",
          "description": "Optional RUSH format (engine 4+). One fixed global deadline covers every set and feedback. Omission defaults to min(10, bank size) questions and 600 seconds.",
          "properties": {
            "question_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "question_count",
            "duration_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "quiz",
        "exam",
        "domain_weights"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "es": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "additionalProperties": false
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "content_updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "schema_version",
    "bank_id",
    "version",
    "exam_code",
    "title",
    "description",
    "languages",
    "default_language",
    "domains",
    "defaults",
    "references"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aws-practice-local:bank-manifest:1",
  "title": "Local Practice Question Bank Manifest, contract v1/v2",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "defaults": {
            "not": {
              "required": [
                "rush"
              ]
            }
          }
        }
      }
    }
  ]
}
